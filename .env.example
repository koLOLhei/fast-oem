# ─── Required ────────────────────────────────────────────────────────

# 見積り依頼フォームのメール送信（Resend）
RESEND_API_KEY=

# ─── Recommended ─────────────────────────────────────────────────────

# フォームのレート制限（Upstash Redis）。未設定時はインスタンス内メモリで代替
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────

# 見積り依頼の Slack 通知
SLACK_WEBHOOK_URL=

# 通知先・送信元（未設定時は contact@soara-mu.com / FAST OEM <noreply@soara-mu.com>）
CONTACT_EMAIL=
FROM_EMAIL=

# Sentry（サーバー側のエラー収集。DSN 未設定なら無効）
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
